@startuml FitManager
scale 0.2
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members

' =========================
' ENTRY POINT
' =========================
package "Entry Point" #LightYellow {
  class Main {
    +main(args: String[]): void
  }
}

' =========================
' USER INTERFACE
' =========================
package "Interface do Usuario (UI)" as UI #PapayaWhip {

  interface UserInterface {
    +showMessage(message: String): void
    +showError(error: String): void
    +showMenu(tittle: String, options: String[], prompt: String): int
    +showEnrollment(code: int, studentName: String, planName: String, startDate: LocalDate, endDate: LocalDate, durationMonths: int, totalPrice: double, pendingAmount: double, status: String): void
    +showEnrollment(enrollment: Enrollment): void
    +showCancelledEnrollment(code: int, studentName: String, planName: String, startDate: LocalDate, endDate: LocalDate, durationMonths: int, totalPrice: double, status: String, cancellationReason: String): void
    +showPlan(planNameList: String, planDescriptionList: String, planTypeList: String, planMinDurationList: int, planPricePerMonthList: double): void
    +showStudent(studentNameList: String, studentCpfList: String, studentContactList: String, studentBirthDateList: String): void
    +showPlanTypeOptions(): void
    +showPaymentTypeOptions(): void
    +getInput(prompt: String): String
    +getInputInt(prompt: String): int
    +getInputDouble(prompt: String): double
    +getInputDate(prompt: String): LocalDate
    +getInputPlanType(prompt: String): PlanType
    +getInputPaymentType(prompt: String): PaymentType
  }

  class TerminalUI {
    -input: Scanner
    +showMessage(message: String): void
    +showError(error: String): void
    +showMenu(tittle: String, options: String[], prompt: String): int
    +showEnrollment(code: int, studentName: String, planName: String, startDate: LocalDate, endDate: LocalDate, durationMonths: int, totalPrice: double, pendingAmount: double, status: String): void
    +showEnrollment(enrollment: Enrollment): void
    +showCancelledEnrollment(code: int, studentName: String, planName: String, startDate: LocalDate, endDate: LocalDate, durationMonths: int, totalPrice: double, status: String, cancellationReason: String): void
    +showPlan(planNameList: String, planDescriptionList: String, planTypeList: String, planMinDurationList: int, planPricePerMonthList: double): void
    +showStudent(studentNameList: String, studentCpfList: String, studentContactList: String, studentBirthDateList: String): void
    +showPlanTypeOptions(): void
    +showPaymentTypeOptions(): void
    +getInput(prompt: String): String
    +getInputInt(prompt: String): int
    +getInputDouble(prompt: String): double
    +getInputDate(prompt: String): LocalDate
    +getInputPlanType(prompt: String): PlanType
    +getInputPaymentType(prompt: String): PaymentType
  }

  class JOptionPaneUI {
    +showMessage(message: String): void
    +showError(error: String): void
    +showMenu(tittle: String, options: String[], prompt: String): int
    +showEnrollment(code: int, studentName: String, planName: String, startDate: LocalDate, endDate: LocalDate, durationMonths: int, totalPrice: double, pendingAmount: double, status: String): void
    +showEnrollment(enrollment: Enrollment): void
    +showCancelledEnrollment(code: int, studentName: String, planName: String, startDate: LocalDate, endDate: LocalDate, durationMonths: int, totalPrice: double, status: String, cancellationReason: String): void
    +showPlan(planNameList: String, planDescriptionList: String, planTypeList: String, planMinDurationList: int, planPricePerMonthList: double): void
    +showStudent(studentNameList: String, studentCpfList: String, studentContactList: String, studentBirthDateList: String): void
    +showPlanTypeOptions(): void
    +showPaymentTypeOptions(): void
    +getInput(prompt: String): String
    +getInputInt(prompt: String): int
    +getInputDouble(prompt: String): double
    +getInputDate(prompt: String): LocalDate
    +getInputPlanType(prompt: String): PlanType
    +getInputPaymentType(prompt: String): PaymentType
  }

  class MainMenu {
    -ui: UserInterface
    -fitManager: FitManager
    +MainMenu(ui: UserInterface, fitManager: FitManager)
    +start(): void
  }

  class StudentsMenu {
    -ui: UserInterface
    -fitManager: FitManager
    +StudentsMenu(ui: UserInterface, fitManager: FitManager)
    +run(): void
    +formatStudentList(studentList: ArrayList<Student>): String
  }

  class PlanMenu {
    -ui: UserInterface
    -fitManager: FitManager
    +PlanMenu(ui: UserInterface, fitManager: FitManager)
    +run(): void
    +formatPlanList(planList: ArrayList<Plan>): String
  }

  class EnrollmentMenu {
    -ui: UserInterface
    -fitManager: FitManager
    +EnrollmentMenu(ui: UserInterface, fitManager: FitManager)
    +run(): void
    -collectAndRegisterPayment(enrollmentCode: int, amount: double, paymentType: PaymentType, description: String): OperationResult<Payment>
    -processCancellation(enrollmentCode: int, cancelReason: String, enrollmentHistory: ArrayList<Enrollment>): void
    -collectAndRegisterInitialPayment(cpf: String, planName: String, startDate: LocalDate, durationMonths: int, initialPayment: double, paymentType: PaymentType): OperationResult<Enrollment>
    +formatEnrollmentList(enrollmentHistory: ArrayList<Enrollment>): String
  }

  class ReportsMenu {
    -ui: UserInterface
    -fitManager: FitManager
    +ReportsMenu(ui: UserInterface, fitManager: FitManager)
    +run(): void
    -buildActiveEnrollmentsReport(allEnrollments: ArrayList<Enrollment>): String
    -buildPendingPaymentsReport(allEnrollments: ArrayList<Enrollment>): String
    -buildAllEnrollmentsReport(allEnrollments: ArrayList<Enrollment>): String
  }

  enum MainMenuEnum {
    MANAGE_STUDENTS
    MANAGE_PLANS
    MANAGE_ENROLLMENTS
    REPORTS
    EXIT
    +getOptionNumber(): int
    +getOptionDescription(): String
    +selectFromInt(option: int): MainMenuEnum
  }

  enum StudentMenuEnum {
    REGISTER_STUDENT
    SEARCH_BY_CPF
    DELETE_STUDENT
    ACTIVATE_STUDENT
    VIEW_ALL_STUDENTS
    BACK
    +getOptionNumber(): int
    +getOptionDescription(): String
    +selectFromInt(option: int): StudentMenuEnum
  }

  enum PlanMenuEnum {
    REGISTER_NEW_PLAN
    CHECK_BY_NAME
    CHANGE_PRICE
    VIEW_ALL
    BACK
    +getOptionNumber(): int
    +getOptionDescription(): String
    +selectFromInt(option: int): PlanMenuEnum
  }

  enum EnrollmentMenuEnum {
    REGISTER_ENROLLMENT
    REGISTER_PAYMENT
    CANCEL_ENROLLMENT
    CHECK_ACTIVE_ENROLLMENT
    VIEW_HISTORY
    BACK
    +getOptionNumber(): int
    +getOptionDescription(): String
    +selectFromInt(option: int): EnrollmentMenuEnum
  }

  enum ReportsMenuEnum {
    ACTIVE_ENROLLMENTS_STUDENTS
    PENDING_PAYMENTS_ENROLLMENTS
    ALL_ENROLLMENTS
    MONTHLY_FINANCIAL_REPORT
    BACK
    +getOptionNumber(): int
    +getOptionDescription(): String
    +selectFromInt(option: int): ReportsMenuEnum
  }
}

' =========================
' APPLICATION
' =========================
package "Aplicacao" as APP #MistyRose {

  class FitManager {
    -studentService: StudentService
    -planService: PlanService
    -enrollmentService: EnrollmentService
    -{static} FILE_STUDENTS: String
    -{static} FILE_PLANS: String
    -{static} FILE_ENROLLMENTS: String
    +FitManager()
    +loadAll(): void
    +saveAll(): void
    -persistAfterMutation<T>(result: OperationResult<T>): OperationResult<T>
    +registerStudent(name: String, cpf: String, contact: String, birthDate: LocalDate): OperationResult<Student>
    +findStudentByCpf(cpf: String): Student
    +removeStudent(cpf: String): OperationResult<Student>
    +activateStudent(cpf: String): OperationResult<Student>
    +listStudents(): ArrayList<Student>
    +registerPlan(name: String, description: String, type: PlanType, minDurationMonths: int, pricePerMonth: double): OperationResult<Plan>
    +findPlanByName(name: String): OperationResult<Plan>
    +updatePlanPrice(name: String, newPrice: double): OperationResult<Plan>
    +listPlans(): ArrayList<Plan>
    +enrollStudent(cpf: String, planName: String, startDate: LocalDate, durationMonths: int, paymentDescription: String, initialAmount: double, pixKey: String): OperationResult<Enrollment>
    +enrollStudent(cpf: String, planName: String, startDate: LocalDate, durationMonths: int, initialAmount: double, paymentDescription: String, amountReceived: double): OperationResult<Enrollment>
    +enrollStudent(cpf: String, planName: String, startDate: LocalDate, durationMonths: int, initialAmount: double, paymentDescription: String, cardLastDigits: String): OperationResult<Enrollment>
    +enrollStudent(cpf: String, planName: String, startDate: LocalDate, durationMonths: int, initialAmount: double, paymentDescription: String, installments: int, cardLastDigits: String): OperationResult<Enrollment>
    +registerPaymentPix(code: int, amount: double, description: String, pixKey: String): OperationResult<Payment>
    +registerPaymentCash(code: int, amount: double, description: String, amountReceived: double): OperationResult<Payment>
    +registerPaymentDebit(code: int, amount: double, description: String, cardLastDigits: String): OperationResult<Payment>
    +registerPaymentCredit(code: int, amount: double, description: String, installments: int, cardLastDigits: String): OperationResult<Payment>
    +findEnrollmentByCode(code: int): OperationResult<Enrollment>
    +cancelEnrollment(code: int, reason: String): OperationResult<Enrollment>
    +calculateCancelationFee(code: int): OperationResult<Double>
    +findActiveEnrollment(cpf: String): OperationResult<Enrollment>
    +listEnrollments(): ArrayList<Enrollment>
    +generateMonthlyReport(month: int, year: int): OperationResult<FinancialReport>
    +exportMonthlyReport(report: FinancialReport): OperationResult<String>
    -validate(cpf: String, planName: String, initialAmount: double): boolean
    -validationError(cpf: String, planName: String, initialAmount: double): OperationResult<Enrollment>
    -trySaveAll(): void
  }

  class StudentService extends Repository<Student> {
    -students: ArrayList<Student>
    +registerStudent(name: String, cpf: String, contact: String, birthDate: LocalDate): OperationResult<Student>
    +findByCpf(cpf: String): Student
    +removeStudent(cpf: String): OperationResult<Student>
    +listStudents(): ArrayList<Student>
    +cpfExists(cpf: String): boolean
    +reactivateStudent(cpf: String): OperationResult<Student>
    +save(filePath: String): void
    +load(filePath: String): void
    -encode(s: Student): String
  }

  class PlanService extends Repository<Plan> {
    -{static} plans: ArrayList<Plan>
    -{static} SEP: String
    -{static} SEP_REGEX: String
    +listPlans(): ArrayList<Plan>
    +findByName(name: String): OperationResult<Plan>
    +nameExists(name: String): boolean
    +registerPlan(name: String, description: String, type: PlanType, minDurationMonths: int, pricePerMonth: double): OperationResult<Plan>
    +updatePrice(name: String, newPrice: double): OperationResult<Plan>
    +save(filePath: String): void
    +load(filePath: String): void
    -encode(p: Plan): String
    -instantiatePlan(typeName: String, name: String, description: String, minDuration: int, price: double, lineNumber: int, filePath: String): Plan
  }

  class EnrollmentService extends Repository<Enrollment> {
    -enrollments: ArrayList<Enrollment>
    -nextCode: int
    -{static} SEP: String
    -{static} SEP_REGEX: String
    -{static} NEXT_CODE_KEY: String
    -{static} PAYMENT_PREFIX: String
    -{static} END_PAYMENTS: String
    -{static} NULL_MARKER: String
    +enroll(student: Student, plan: Plan, startDate: LocalDate, duration: int, payment: Payment): OperationResult<Enrollment>
    -validatePayment(payment: Payment): OperationResult<Boolean>
    +registerPayment(code: int, payment: Payment): OperationResult<Payment>
    +findActiveByStudent(cpf: String): Enrollment
    +findByCode(code: int): Enrollment
    +listEnrollments(): ArrayList<Enrollment>
    +cancel(code: int, reason: String): OperationResult<Enrollment>
    +calculateCancelationFee(code: int): OperationResult<Double>
    +hasActiveEnrollment(cpf: String): boolean
    +save(filePath: String): void
    +load(filePath: String, students: StudentService, plans: PlanService): void
    +load(filePath: String): void
    -encodeHeader(e: Enrollment): String
    -decodeHeader(line: String, lineNumber: int, filePath: String, students: StudentService, plans: PlanService): Enrollment
    -encodePayment(p: Payment): String
    -decodePayment(line: String, lineNumber: int, filePath: String): Payment
  }

  abstract class Repository<T> {
    #items: List<T>
    +listAll(): List<T>
    +count(): int
    +{abstract} save(filePath: String): void
    +{abstract} load(filePath: String): void
  }

  class OperationResult<T> {
    -success: boolean
    -message: String
    -data: T
    +OperationResult(success: boolean, message: String)
    +OperationResult(success: boolean, message: String, data: T)
    +isSuccess(): boolean
    +getMessage(): String
    +getData(): T
  }

  class FinancialReport {
    -month: int
    -year: int
    -totalRevenue: double
    -revenueByPlanType: Map<String, Double>
    -revenueByPaymentType: Map<String, Double>
    -totalProcessingFees: double
    -enrollmentsStarted: int
    -enrollmentsCancelled: int
    -mostContractedPlanTypes: ArrayList<String>
    +FinancialReport(month: int, year: int)
    +calculate(enrollments: ArrayList<Enrollment>): void
    -resetMetrics(): void
    -updateMostContractedPlanTypes(contractedCountByPlanType: Map<String, Integer>): void
    -isSamePeriod(date: LocalDate): boolean
    +toDisplayString(): String
    -appendRevenueMap(reportText: StringBuilder, source: Map<String, Double>): void
    +exportToFile(directoryPath: String): String
    +getMonth(): int
    +getYear(): int
    +getTotalRevenue(): double
    +getRevenueByPlanType(): Map<String, Double>
    +getRevenueByPaymentType(): Map<String, Double>
    +getTotalProcessingFees(): double
    +getEnrollmentsStarted(): int
    +getEnrollmentsCancelled(): int
    +getMostContractedPlanTypes(): ArrayList<String>
  }
}

' =========================
' DOMAIN
' =========================
package "Dominio" as DOM #PowderBlue {

  class Student {
    -name: String
    -cpf: String
    -contact: String
    -birthDate: LocalDate
    -active: boolean
    -{static} dateFormatter: DateTimeFormatter
    +Student(name: String, cpf: String, contact: String, birthDate: LocalDate)
    +setName(name: String): void
    +setCpf(cpf: String): void
    +setContact(contact: String): void
    +setBirthDate(birthDate: LocalDate): void
    +activate(): void
    +deactivate(): void
    +getName(): String
    +getCpf(): String
    +getFormattedCpf(): String
    +getContact(): String
    +getBirthDate(): LocalDate
    +getFormattedBirthDate(): String
    +isActive(): boolean
    +calculateAge(): int
    +{static} validateCpf(cpf: String): boolean
    +equals(obj: Object): boolean
    +hashCode(): int
  }

  abstract class Plan {
    -name: String
    -description: String
    -minDurationMonths: int
    -pricePerMonth: double
    +Plan(name: String, description: String, minDurationMonths: int, pricePerMonth: double)
    +setName(name: String): void
    +setDescription(description: String): void
    +setMinDurationMonths(minDurationMonths: int): void
    +updatePrice(newPrice: double): void
    +getName(): String
    +getDescription(): String
    +getMinDurationMonths(): int
    +getPricePerMonth(): double
    +{abstract} getType(): PlanType
    +{abstract} calculateTotalPrice(months: int): double
    +{abstract} getCancellationFee(enrollment: Enrollment): double
    +equals(obj: Object): boolean
    +hashCode(): int
  }

  class PlanMonthly {
    +PlanMonthly(name: String, description: String, minDurationMonths: int, pricePerMonth: double)
    +getType(): PlanType
    +calculateTotalPrice(months: int): double
    +getCancellationFee(enrollment: Enrollment): double
  }

  class PlanQuarterly {
    +PlanQuarterly(name: String, description: String, minDurationMonths: int, pricePerMonth: double)
    +getType(): PlanType
    +calculateTotalPrice(months: int): double
    +getCancellationFee(enrollment: Enrollment): double
  }

  class PlanSemiAnnual {
    +PlanSemiAnnual(name: String, description: String, minDurationMonths: int, pricePerMonth: double)
    +getType(): PlanType
    +calculateTotalPrice(months: int): double
    +getCancellationFee(enrollment: Enrollment): double
  }

  class PlanAnnual {
    +PlanAnnual(name: String, description: String, minDurationMonths: int, pricePerMonth: double)
    +getType(): PlanType
    +calculateTotalPrice(months: int): double
    +getCancellationFee(enrollment: Enrollment): double
  }

  enum PlanType {
    MONTHLY
    QUARTERLY
    SEMI_ANNUAL
    ANNUAL
    +getValueOption(): int
    +getDescription(): String
    +selectFromInt(option: int): PlanType
  }

  class Enrollment {
    -code: int
    -student: Student
    -plan: Plan
    -startDate: LocalDate
    -endDate: LocalDate
    -durationMonths: int
    -totalPrice: double
    -status: EnrollmentStatus
    -payments: ArrayList<Payment>
    -cancellationDate: LocalDate
    -cancellationReason: String
    +Enrollment(code: int, student: Student, plan: Plan, startDate: LocalDate, durationMonths: int)
    +registerPayment(payment: Payment): void
    +calculateTotalPaid(): double
    +calculateBalance(): double
    +calculateBalanceForMonthsUsed(): double
    +cancel(reason: String): void
    +cancelWithDate(cancDate: LocalDate, reason: String): void
    +getMonthsUsed(): long
    +getCode(): int
    +getStudent(): Student
    +getPlan(): Plan
    +getStartDate(): LocalDate
    +getEndDate(): LocalDate
    +getDurationMonths(): int
    +getTotalPrice(): double
    +getStatus(): EnrollmentStatus
    +getPayments(): List<Payment>
    +getCancellationDate(): LocalDate
    +getCancellationReason(): String
    +equals(obj: Object): boolean
    +hashCode(): int
  }

  enum EnrollmentStatus {
    ACTIVE
    CANCELLED
    +getDescription(): String
  }

  abstract class Payment {
    -date: LocalDate
    -amount: double
    -description: String
    -{static} DATE_FORMATTER: DateTimeFormatter
    +Payment(date: LocalDate, amount: double, description: String)
    +getDate(): LocalDate
    +getAmount(): double
    +getDescription(): String
    +getFormattedDate(): String
    +{abstract} getProcessingFee(): double
    +{abstract} getType(): PaymentType
    +{abstract} getPaymentSummary(): String
    +equals(obj: Object): boolean
    +hashCode(): int
  }

  class CashPayment {
    -amountReceived: double
    +CashPayment(date: LocalDate, amount: double, description: String, amountReceived: double)
    +getAmountReceived(): double
    +getChange(): double
    +getType(): PaymentType
    +getProcessingFee(): double
    +getPaymentSummary(): String
  }

  class CreditCardPayment {
    -installments: int
    -cardLastDigits: String
    -{static} PROCESSING_FEE_RATE: double
    +CreditCardPayment(date: LocalDate, amount: double, description: String, installments: int, cardLastDigits: String)
    +getInstallments(): int
    +getCardLastDigits(): String
    +getType(): PaymentType
    +getProcessingFee(): double
    +getPaymentSummary(): String
  }

  class DebitCardPayment {
    -cardLastDigits: String
    +DebitCardPayment(date: LocalDate, amount: double, description: String, cardLastDigits: String)
    +getCardLastDigits(): String
    +getType(): PaymentType
    +getProcessingFee(): double
    +getPaymentSummary(): String
  }

  class PixPayment {
    -pixKey: String
    +PixPayment(date: LocalDate, amount: double, description: String, pixKey: String)
    +getPixKey(): String
    +getType(): PaymentType
    +getProcessingFee(): double
    +getPaymentSummary(): String
  }

  enum PaymentType {
    PIX
    CREDIT_CARD
    DEBIT_CARD
    CASH
    +getValueOpcao(): int
    +getDescription(): String
    +selectFromInt(option: int): PaymentType
  }
}

' =========================
' EXCEPTIONS
' =========================
package "Excecoes" as EXC #LightGray {
  class FitManagerException {
    +FitManagerException(message: String)
    +FitManagerException(message: String, cause: Throwable)
  }
  class BusinessException {
    +BusinessException(message: String)
    +BusinessException(message: String, cause: Throwable)
  }
  class ValidationException {
    +ValidationException(message: String)
    +ValidationException(message: String, cause: Throwable)
  }
  class PersistenceException {
    -filePath: String
    +PersistenceException(message: String, filePath: String)
    +PersistenceException(message: String, filePath: String, cause: Throwable)
    +getFilePath(): String
  }
  class CorruptedFileException {
    +CorruptedFileException(message: String, filePath: String)
    +CorruptedFileException(message: String, filePath: String, cause: Throwable)
  }
  class WriteFailureException {
    +WriteFailureException(message: String, filePath: String)
    +WriteFailureException(message: String, filePath: String, cause: Throwable)
  }
  class DuplicatedPlanException {
    +DuplicatedPlanException(planName: String)
  }
  class DuplicateEnrollmentException {
    +DuplicateEnrollmentException(cpf: String)
  }
  class InvalidFormatFieldException {
    +InvalidFormatFieldException(fieldName: String, expectedFormat: String)
    +InvalidFormatFieldException(fieldName: String, expectedFormat: String, cause: Throwable)
  }
  class RequiredFieldException {
    +RequiredFieldException(fieldName: String)
  }
  class StudentWithActiveEnrollmentException {
    +StudentWithActiveEnrollmentException(cpf: String)
  }
}

' =========================
' RELATIONS
' =========================

top to bottom direction
UI -[hidden]down-> APP
APP -[hidden]down-> DOM
DOM -[hidden]down-> EXC

' UI Realization
TerminalUI ..|> UserInterface
JOptionPaneUI ..|> UserInterface

' Repository Inheritance
StudentService --|> Repository
PlanService --|> Repository
EnrollmentService --|> Repository

' Plan Inheritance
PlanMonthly --|> Plan
PlanQuarterly --|> Plan
PlanSemiAnnual --|> Plan
PlanAnnual --|> Plan

' Payment Inheritance
CashPayment --|> Payment
CreditCardPayment --|> Payment
DebitCardPayment --|> Payment
PixPayment --|> Payment

' Exception Inheritance
BusinessException --|> FitManagerException
ValidationException --|> FitManagerException
PersistenceException --|> FitManagerException
CorruptedFileException --|> PersistenceException
WriteFailureException --|> PersistenceException
DuplicatedPlanException --|> BusinessException
DuplicateEnrollmentException --|> BusinessException
InvalidFormatFieldException --|> ValidationException
RequiredFieldException --|> ValidationException
StudentWithActiveEnrollmentException --|> BusinessException

' Main connections
Main --> MainMenu
Main --> UserInterface
Main --> FitManager

' UI Menu connections
MainMenu --> UserInterface
MainMenu --> FitManager
MainMenu --> StudentsMenu
MainMenu --> PlanMenu
MainMenu --> EnrollmentMenu
MainMenu --> ReportsMenu

StudentsMenu --> UserInterface
StudentsMenu --> FitManager
PlanMenu --> UserInterface
PlanMenu --> FitManager
EnrollmentMenu --> UserInterface
EnrollmentMenu --> FitManager
ReportsMenu --> UserInterface
ReportsMenu --> FitManager

' Enum usage by menus
MainMenu --> MainMenuEnum
StudentsMenu --> StudentMenuEnum
PlanMenu --> PlanMenuEnum
EnrollmentMenu --> EnrollmentMenuEnum
ReportsMenu --> ReportsMenuEnum

' FitManager composition of services
FitManager *-- StudentService
FitManager *-- PlanService
FitManager *-- EnrollmentService
FitManager --> OperationResult
FitManager --> FinancialReport

' Services contain domain objects
StudentService "1" o-- "0..*" Student
PlanService "1" o-- "0..*" Plan
EnrollmentService "1" o-- "0..*" Enrollment

' Enrollment relationships
Enrollment "0..*" --> "1" Student
Enrollment "0..*" --> "1" Plan
Enrollment "1" *-- "0..*" Payment
Enrollment --> EnrollmentStatus

' Plan uses PlanType
Plan --> PlanType

' Payment uses PaymentType
Payment --> PaymentType

' FinancialReport depends on Enrollment
FinancialReport ..> Enrollment : calculates

' Persistence dependencies (throws)
StudentService ..> PersistenceException : throws
StudentService ..> CorruptedFileException : throws
StudentService ..> WriteFailureException : throws
PlanService ..> PersistenceException : throws
PlanService ..> CorruptedFileException : throws
PlanService ..> WriteFailureException : throws
EnrollmentService ..> PersistenceException : throws
EnrollmentService ..> CorruptedFileException : throws
EnrollmentService ..> WriteFailureException : throws
FitManager ..> PersistenceException : throws

@enduml